# ---- AI (required for "smart answers"; the bot still works without it using rule-based answers)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Storage: add the "Upstash Redis" integration from the Vercel Marketplace (it sets these for you)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Email alerts to the follow-up team (https://resend.com, free tier is enough to start)
RESEND_API_KEY=re_...
EMAIL_FROM=CCI Olu-Obasanjo <alerts@yourdomain.org>
FOLLOWUP_EMAIL=followup@yourchurch.org,second@yourchurch.org

# ---- Staff login. Generate hashes with:  npm run hash -- "the-password"
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_USERS=[{"email":"pastor@yourchurch.org","name":"Pastor Ada","hash":"scrypt$...","owner":true}]

# ---- Optional
PUBLIC_URL=https://your-project.vercel.app
